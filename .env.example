# Runtime
APP_ENV=development
LOG_LEVEL=INFO
APP_PORT=8080
# Safe default: expose the application only to a same-host HTTPS terminator.
APP_BIND_ADDRESS=127.0.0.1
# Build both images for the Linux/amd64 production target. Apple Silicon Docker
# uses emulation instead of silently producing a mixed-architecture image set.
TARGET_PLATFORM=linux/amd64
DATABASE_URL=sqlite:////app/data/app.db
TEMP_DIR=/tmp/expense
# Durable reimbursement originals and generated workbooks. This must not point
# into TEMP_DIR; Compose mounts a separate named volume at this path.
REIMBURSEMENT_STAGING_DIR=/app/staging
REIMBURSEMENT_STAGING_MAX_BYTES=4294967296
REIMBURSEMENT_DRAFT_TTL_DAYS=30
EXCEL_TEMPLATE_PATH=/app/app/templates/expense_template.xlsx

# Phase 2: DingTalk identity. Never commit real values.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
# Positive numeric AgentId for the same enterprise internal application.
DINGTALK_AGENT_ID=
# Signed upload URLs are accepted only on these vetted HTTPS host suffixes.
DINGTALK_STORAGE_UPLOAD_TIMEOUT_SECONDS=120
DINGTALK_STORAGE_UPLOAD_HOST_SUFFIXES=trans.dingtalk.com
# Durable OA submission worker. Keep the detail URL empty until its exact
# tenant/client deep-link format has been verified; processInstanceId is still returned.
# Keep false until migrations, templates, permissions, and one acceptance run are verified.
# Production must opt in explicitly only after those checks pass.
DINGTALK_OA_WORKER_ENABLED=false
DINGTALK_OA_WORKER_POLL_INTERVAL_SECONDS=1
DINGTALK_OA_WORKER_LEASE_SECONDS=180
DINGTALK_OA_WORKER_RETRY_BASE_SECONDS=5
DINGTALK_OA_WORKER_RETRY_MAX_SECONDS=300
DINGTALK_OA_WORKER_RECONCILIATION_SECONDS=900
DINGTALK_APPROVAL_DETAIL_URL_TEMPLATE=
SESSION_SECRET=
ADMIN_USER_IDS=
SESSION_COOKIE_NAME=expense_session
SESSION_TTL_MINUTES=480
# Expired server sessions are purged on startup and opportunistically at this interval.
SESSION_CLEANUP_INTERVAL_SECONDS=300
# false supports HTTP and HTTPS; set true when the browser-facing entry uses HTTPS only.
SESSION_COOKIE_SECURE=false

# Explicit development/test convenience; keep false unless intentionally testing outside DingTalk.
AUTH_MOCK_ENABLED=false
AUTH_MOCK_USER_ID=mock-user
AUTH_MOCK_USER_NAME=开发测试用户
AUTH_MOCK_DEPARTMENTS=100:测试部门

# Temporary receipt limits. One file is exactly one receipt; PDF must be one page.
UPLOAD_TTL_MINUTES=30
TEMP_CLEANUP_INTERVAL_SECONDS=600
UPLOAD_MAX_FILE_BYTES=20971520
# One multipart request carries exactly one file; this includes envelope headroom.
UPLOAD_MAX_REQUEST_BYTES=26214400
UPLOAD_SPOOL_MEMORY_BYTES=262144
# Retained quotas apply across repeated requests in one Session. The global
# cap includes active/orphan spool files. A one-file transfer peak plus the
# explicit runtime reserve keeps worst-case use below the Compose 1 GiB tmpfs.
SESSION_MAX_FILES=200
SESSION_MAX_BYTES=104857600
EXPENSE_MAX_ITEMS=200
TEMP_STORAGE_MAX_BYTES=805306368
TEMP_STORAGE_RESERVE_BYTES=209715200
IMAGE_MAX_PIXELS=50000000
IMAGE_MAX_DIMENSION=20000
PDF_RENDER_DPI=200
PDF_MAX_XOBJECTS=100
PDF_MAX_CONTENT_STREAMS=512
PDF_MAX_EMBEDDED_PIXELS=100000000
PDF_MAX_RESOURCE_DEPTH=8
PDF_MAX_DECODED_PAGE_BYTES=33554432
PDF_PREFLIGHT_TIMEOUT_SECONDS=30
IMAGE_VALIDATION_TIMEOUT_SECONDS=30
FILE_OPERATION_WAIT_SECONDS=5
UPLOAD_ADMISSION_WAIT_SECONDS=1
PROCESS_JOB_ADMISSION_WAIT_SECONDS=1
# Linux AnyIO worker subprocess limits. File validation stays small; OCR gets a separate ceiling.
LOGOUT_FILE_WAIT_SECONDS=130
FILE_WORKER_MEMORY_LIMIT_BYTES=536870912
OCR_WORKER_MEMORY_LIMIT_BYTES=5368709120
WORKER_FILE_SIZE_LIMIT_BYTES=67108864
WORKER_OPEN_FILES_LIMIT=128
WORKER_CPU_SECONDS=180
BACKEND_MEMORY_LIMIT=3g
BACKEND_PIDS_LIMIT=128
WEB_MEMORY_LIMIT=128m
WEB_PIDS_LIMIT=64

# V1 OCR is local-only and enabled by default. Missing dependencies or verified
# models make readiness fail instead of silently starting without recognition.
# Production remains restricted to Linux x86_64/amd64.
OCR_MODE=local
OCR_ENABLED=true
OCR_FAKE_ENABLED=false
OCR_CONCURRENCY=1
# Keep one OCR process, but let a small number of requests wait in arrival order.
OCR_QUEUE_MAX_WAITERS=8
OCR_QUEUE_WAIT_SECONDS=150
OCR_TIMEOUT_SECONDS=120
OCR_CPU_THREADS=4
OCR_ENGINE=paddle_static
# OCR dependencies are installed in the normal production image.
INSTALL_OCR=true
OCR_MODEL_HOST_DIR=./backend/models
OCR_DETECTION_MODEL_DIR=/opt/expense/models/PP-OCRv6_small_det
OCR_RECOGNITION_MODEL_DIR=/opt/expense/models/PP-OCRv6_small_rec
