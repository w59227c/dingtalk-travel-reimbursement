# Copy this file to .env.dingtalk-dev. The real file is gitignored.
# Values containing shell-special characters must be quoted.

# Real organization application credentials.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_WORKFLOW_INSTANCE_READ_MIN_INTERVAL_SECONDS=0.2
DINGTALK_STORAGE_UPLOAD_TIMEOUT_SECONDS=120
DINGTALK_STORAGE_UPLOAD_HOST_SUFFIXES=trans.dingtalk.com
# Keep false until migrations, templates, permissions, and one acceptance run are verified.
# Set true only for an intentional post-check acceptance run.
DINGTALK_OA_WORKER_ENABLED=false
DINGTALK_OA_WORKER_POLL_INTERVAL_SECONDS=1
DINGTALK_OA_WORKER_LEASE_SECONDS=180
DINGTALK_OA_WORKER_RETRY_BASE_SECONDS=5
DINGTALK_OA_WORKER_RETRY_MAX_SECONDS=300
DINGTALK_OA_WORKER_RECONCILIATION_SECONDS=900
DINGTALK_APPROVAL_DETAIL_URL_TEMPLATE=

# Leave the path empty to use backend/data/reimbursement-staging in the local
# launcher. Set an absolute path only when local durable files belong elsewhere.
REIMBURSEMENT_STAGING_DIR=
REIMBURSEMENT_STAGING_MAX_BYTES=4294967296
REIMBURSEMENT_DRAFT_TTL_DAYS=30

# Optional for local DingTalk debugging. When empty, the backend script creates
# an in-memory random value for this run. Never reuse a production secret here.
SESSION_SECRET=

# Optional comma-separated DingTalk userIds that may access admin pages.
ADMIN_USER_IDS=

# PC DingTalk can open http://127.0.0.1:5173 through the official debug tool.
# Keep these empty/default values for that local HTTP flow.
DINGTALK_DEV_PUBLIC_HOST=
DINGTALK_DEV_COOKIE_SECURE=false

# For an external HTTPS reverse proxy, set the hostname (without scheme/path),
# set DINGTALK_DEV_COOKIE_SECURE=true, and change the bind address only if the proxy connects
# over the LAN rather than from this Mac.
# DINGTALK_DEV_PUBLIC_HOST=expense-dev.example.com
# DINGTALK_DEV_COOKIE_SECURE=true
DINGTALK_DEV_BIND_ADDRESS=127.0.0.1
DINGTALK_DEV_FRONTEND_PORT=5173
