{
  "name": "dingtalk-travel-reimbursement-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run typecheck && vite build",
    "typecheck": "npm run typecheck:native && vue-tsc -b",
    "typecheck:native": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dingtalk-jsapi": "3.2.9",
    "element-plus": "2.14.5",
    "pdfjs-dist": "6.3.289",
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-sfc": "3.5.42",
    "@vue/test-utils": "2.5.0",
    "dingtalk-h5-remote-debug": "0.1.3",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.69.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
