# 16C / 32 GiB / 100 GiB production profile.
# Copy this file to .env beside compose.yaml, run chmod 600 .env, and fill every
# empty DingTalk/security value before starting the containers.

# Image and network
IMAGE_TAG=main
APP_ENV=production
LOG_LEVEL=INFO
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
TARGET_PLATFORM=linux/amd64

# Container budgets: reserve host capacity for Docker, page cache and backups.
BACKEND_CPUS=12.0
BACKEND_MEMORY_LIMIT=16g
BACKEND_PIDS_LIMIT=256
WEB_CPUS=1.0
WEB_MEMORY_LIMIT=256m
WEB_PIDS_LIMIT=64

# Durable and temporary storage
DATABASE_URL=sqlite:////app/data/app.db
TEMP_DIR=/tmp/expense
REIMBURSEMENT_STAGING_DIR=/app/staging
# 30 GiB logical ceiling on the 100 GiB server disk.
REIMBURSEMENT_STAGING_MAX_BYTES=32212254720
REIMBURSEMENT_DRAFT_TTL_DAYS=30
EXCEL_TEMPLATE_PATH=/app/app/templates/expense_template.xlsx

# DingTalk identity. All four values must belong to the same internal app.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_WORKFLOW_INSTANCE_READ_MIN_INTERVAL_SECONDS=0.2
DINGTALK_STORAGE_UPLOAD_TIMEOUT_SECONDS=120
DINGTALK_STORAGE_UPLOAD_HOST_SUFFIXES=trans.dingtalk.com

# Keep disabled through migration, template, permission and real acceptance checks.
# Change to true only when production is ready to consume queued submissions.
DINGTALK_OA_WORKER_ENABLED=false
DINGTALK_OA_WORKER_POLL_INTERVAL_SECONDS=1
DINGTALK_OA_WORKER_LEASE_SECONDS=180
DINGTALK_OA_WORKER_RETRY_BASE_SECONDS=5
DINGTALK_OA_WORKER_RETRY_MAX_SECONDS=300
DINGTALK_OA_WORKER_RECONCILIATION_SECONDS=900
DINGTALK_APPROVAL_DETAIL_URL_TEMPLATE=

# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Comma-separated DingTalk userIds; at least one is required in production.
ADMIN_USER_IDS=
SESSION_COOKIE_NAME=expense_session
SESSION_TTL_MINUTES=480
SESSION_CLEANUP_INTERVAL_SECONDS=300
# Use true only when every browser entry is HTTPS. Keep false for direct HTTP.
SESSION_COOKIE_SECURE=true

# Production must never enable mock authentication or fake OCR.
AUTH_MOCK_ENABLED=false
OCR_MODE=local
OCR_ENABLED=true
OCR_FAKE_ENABLED=false
OCR_ENGINE=paddle_static
OCR_DETECTION_MODEL_DIR=/opt/expense/models/PP-OCRv6_small_det
OCR_RECOGNITION_MODEL_DIR=/opt/expense/models/PP-OCRv6_small_rec

# Upload and per-session business limits
UPLOAD_TTL_MINUTES=30
TEMP_CLEANUP_INTERVAL_SECONDS=600
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_REQUEST_BYTES=26214400
UPLOAD_SPOOL_MEMORY_BYTES=262144
SESSION_MAX_FILES=200
SESSION_MAX_BYTES=104857600
EXPENSE_MAX_ITEMS=200

# /tmp/expense is a 1 GiB tmpfs in Compose. These values must remain below it.
TEMP_STORAGE_MAX_BYTES=805306368
TEMP_STORAGE_RESERVE_BYTES=209715200

# File and PDF safety limits
IMAGE_MAX_PIXELS=50000000
IMAGE_MAX_DIMENSION=20000
PDF_RENDER_DPI=200
PDF_MAX_XOBJECTS=100
PDF_MAX_CONTENT_STREAMS=512
PDF_MAX_EMBEDDED_PIXELS=100000000
PDF_MAX_RESOURCE_DEPTH=8
PDF_MAX_DECODED_PAGE_BYTES=33554432
PDF_PREFLIGHT_TIMEOUT_SECONDS=30
IMAGE_VALIDATION_TIMEOUT_SECONDS=30
FILE_OPERATION_WAIT_SECONDS=5
UPLOAD_ADMISSION_WAIT_SECONDS=1
PROCESS_JOB_ADMISSION_WAIT_SECONDS=1
LOGOUT_FILE_WAIT_SECONDS=130
FILE_WORKER_MEMORY_LIMIT_BYTES=536870912
OCR_WORKER_MEMORY_LIMIT_BYTES=8589934592
WORKER_FILE_SIZE_LIMIT_BYTES=67108864
WORKER_OPEN_FILES_LIMIT=256
WORKER_CPU_SECONDS=180

# Current architecture intentionally supports one OCR execution slot. The worker
# uses eight CPU threads; other requests wait fairly in the bounded FIFO queue.
OCR_CONCURRENCY=1
OCR_QUEUE_MAX_WAITERS=8
OCR_QUEUE_WAIT_SECONDS=180
OCR_TIMEOUT_SECONDS=120
OCR_CPU_THREADS=8
